# =========================================================================
# CONFIGURAÇÃO DE VARIÁVEIS DE AMBIENTE (GOOGLE SHEETS + FASTIFY)
# =========================================================================

# Porta do servidor Fastify
PORT=3333
HOST=0.0.0.0

# URL publicada como Web App no Google Apps Script (termina em /exec)
GOOGLE_SHEETS_WEB_APP_URL=""

# Mesmo token definido na propriedade WEB_APP_TOKEN do Apps Script.
# Gere um valor longo e aleatório; não o coloque no frontend nem compartilhe publicamente.
GOOGLE_SHEETS_WEB_APP_TOKEN=""
